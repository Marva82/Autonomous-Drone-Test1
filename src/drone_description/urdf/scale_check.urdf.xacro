<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mesh_scale_check">

  <!-- INSTRUCTOR DIMENSIONS -->
  <!-- Frame Diagonal: 0.45 m (45 cm) -->
  <!-- Body Width:     0.18 m (18 cm) -->
  <!-- Prop Radius:    0.127 m (12.7 cm) -->

  <!-- ========================================== -->
  <!-- 1. MAIN BODY LINK                          -->
  <!-- ========================================== -->
  <link name="base_link">
    
    <!-- VISUAL: The beautiful, high-poly CAD mesh -->
    <visual>
      <!-- OFFSET FIX: Shifting the mesh center to match the link center -->
      <origin xyz="-0.02 -0.02 -0.01" rpy="0 0 0"/>
      
      <!-- URI and SCALE FIX: Calling by package name, shrinking mm to meters -->
      <geometry>
        <mesh filename="package://drone_description/meshes/frame.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- COLLISION: A simple, convex box matching the 18cm body width -->
    <collision>
      <!-- Centered perfectly on the link -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.05"/>
      </geometry>
    </collision>

    <!-- (Inertia tags omitted for this scale check exercise) -->
  </link>

  <!-- ========================================== -->
  <!-- 2. ROTOR LINK (Demonstrating Hub Collision)-->
  <!-- ========================================== -->
  <link name="rotor_fl">
    
    <!-- VISUAL: A complex 12.7cm radius propeller mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/prop_ccw.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- COLLISION: Using ONLY the motor hub, NOT the 12.7cm swept disc -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- A tiny 2cm cylinder so the physics engine doesn't snag the blades -->
        <cylinder radius="0.02" length="0.015"/>
      </geometry>
    </collision>
  </link>

  <!-- Connecting the rotor to the base -->
  <joint name="rotor_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_fl"/>
    <!-- Pushing it out along the 45cm diagonal -->
    <origin xyz="0.159 0.159 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>