<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="quadcopter">

  <!-- ========================================== -->
  <!-- MASS BUDGET DASHBOARD (in kg)              -->
  <!-- ========================================== -->
  <!-- Body: 900g -->
  <xacro:property name="mass_body" value="0.900" />
  <!-- Battery: 400g -->
  <xacro:property name="mass_battery" value="0.400" />
  <!-- 4 Arms: 80g total (20g each) -->
  <xacro:property name="mass_arm" value="0.020" />
  <!-- 4 Motors: 55g each -->
  <xacro:property name="mass_motor" value="0.055" />
  <!-- Gimbal + Camera: 50g total -->
  <xacro:property name="mass_gimbal_cam" value="0.050" />
  
  <!-- ========================================== -->
  <!-- THRUST CONSTRAINTS (Reference Only)        -->
  <!-- Total Mass: 1.645 kg (~1.65 kg)            -->
  <!-- Target Hover Force (1g): 16.19 N           -->
  <!-- Target Max Thrust (2:1): 32.38 N           -->
  <!-- Required per motor: 8.09 N                 -->
  <!-- ========================================== -->

  <!-- ========================================== -->
  <!-- 1. INERTIA MATH MACROS                     -->
  <!-- Automatically calculates physics based on mass and size -->
  <!-- ========================================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12)*(y*y + z*z)}" ixy="0" ixz="0" 
               iyy="${(m/12)*(x*x + z*z)}" iyz="0" 
               izz="${(m/12)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12)*(3*r*r + h*h)}" ixy="0" ixz="0" 
               iyy="${(m/12)*(3*r*r + h*h)}" iyz="0" 
               izz="${(m/2)*(r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================== -->
  <!-- 2. CORE BODY & BATTERY                     -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.05"/></geometry>
    </collision>
    <!-- UPDATED: Replaced hardcoded 0.6 with the mass_body variable -->
    <xacro:box_inertia m="${mass_body}" x="0.2" y="0.2" z="0.05"/>
  </link>

  <!-- The battery shifts the center of gravity -->
  <link name="battery_link">
    <visual><geometry><box size="0.1 0.05 0.04"/></geometry></visual>
    <!-- UPDATED: Replaced hardcoded 0.4 with the mass_battery variable -->
    <xacro:box_inertia m="${mass_battery}" x="0.1" y="0.05" z="0.04"/>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <!-- Mounted slightly forward and on top -->
    <origin xyz="0.05 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 3. ARM AND ROTOR MACRO                     -->
  <!-- Write it once, use it 4 times!             -->
  <!-- ========================================== -->
  <xacro:macro name="quad_arm" params="prefix x_pos y_pos rot_dir">
    
    <!-- The Arm Link -->
    <link name="arm_${prefix}">
      <visual><geometry><cylinder radius="0.01" length="0.15"/></geometry></visual>
      <!-- UPDATED: Replaced hardcoded 0.1 with the mass_arm variable -->
      <xacro:cylinder_inertia m="${mass_arm}" r="0.01" h="0.15"/>
    </link>

    <!-- Welded to the base -->
    <joint name="arm_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_${prefix}"/>
      <!-- The math here angles the arm out to the corner -->
      <origin xyz="${x_pos} ${y_pos} 0" rpy="0 1.5708 ${rot_dir * 0.7854}"/>
    </joint>

    <!-- The Rotor Link -->
    <link name="rotor_${prefix}">
      <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry></visual>
      <!-- Collision is ONLY the hub, not the blades -->
      <collision><geometry><cylinder radius="0.02" length="0.01"/></geometry></collision>
      <!-- UPDATED: Replaced hardcoded 0.05 with the mass_motor variable -->
      <xacro:cylinder_inertia m="${mass_motor}" r="0.1" h="0.01"/>
    </link>

    <!-- Continuous joint spinning on the Z axis -->
    <joint name="rotor_${prefix}_joint" type="continuous">
      <parent link="arm_${prefix}"/>
      <child link="rotor_${prefix}"/>
      <!-- Positioned at the end of the arm -->
      <origin xyz="0 0 0.075" rpy="0 -1.5708 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- Instantiating the 4 arms/rotors using the macro -->
  <xacro:quad_arm prefix="fl" x_pos="0.1" y_pos="0.1" rot_dir="1"/>
  <xacro:quad_arm prefix="fr" x_pos="0.1" y_pos="-0.1" rot_dir="-1"/>
  <xacro:quad_arm prefix="rl" x_pos="-0.1" y_pos="0.1" rot_dir="-1"/>
  <xacro:quad_arm prefix="rr" x_pos="-0.1" y_pos="-0.1" rot_dir="1"/>

  <!-- ========================================== -->
  <!-- 4. GIMBAL & CAMERA (Revolute limits)       -->
  <!-- ========================================== -->
  <link name="gimbal_link">
    <visual><geometry><box size="0.02 0.02 0.02"/></geometry></visual>
    <!-- UPDATED: Dividing the total 50g gimbal/cam budget in half for the gimbal -->
    <xacro:box_inertia m="${mass_gimbal_cam / 2}" x="0.02" y="0.02" z="0.02"/>
  </link>

  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="gimbal_link"/>
    <origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Limits: -90 deg (-1.57 rad) to +30 deg (0.52 rad) -->
    <limit lower="-1.5708" upper="0.5236" effort="10" velocity="1.0"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.03 0.03"/></geometry></visual>
    <!-- UPDATED: Dividing the total 50g gimbal/cam budget in half for the camera -->
    <xacro:box_inertia m="${mass_gimbal_cam / 2}" x="0.03" y="0.03" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="gimbal_link"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 5. GAZEBO SENSORS                          -->
  <!-- Injecting real-world noise and update rates-->
  <!-- ========================================== -->

  <!-- SENSORS ON THE CENTER OF MASS (BASE_LINK) -->
  <gazebo reference="base_link">
    
    <!-- 1. IMU (200 Hz) -->
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <imu>
        <!-- Gaussian noise models real-world motor vibrations -->
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>

    <!-- 2. GPS / NAVSAT (10 Hz) -->
    <sensor name="gps_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <navsat>
        <!-- Horizontal noise is tight, Vertical noise is loose due to satellite geometry -->
        <position_extension>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </position_extension>
        <velocity_extension>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </velocity_extension>
      </navsat>
    </sensor>

    <!-- 3. BAROMETER (50 Hz) -->
    <sensor name="baro_sensor" type="altimeter">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <altimeter>
        <vertical_position>
          <!-- Small variance, but inherently drifts over time -->
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </vertical_position>
        <vertical_velocity>
          <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
        </vertical_velocity>
      </altimeter>
    </sensor>

    <!-- 4. DOWNWARD LIDAR (50 Hz) -->
    <!-- Modern Gazebo uses gpu_lidar. We rotate it -90 degrees (pitch) to point at the ground -->
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <pose>0 0 0 0 1.5708 0</pose> 
      <ray>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
        </scan>
        <range><min>0.1</min><max>40.0</max><resolution>0.01</resolution></range>
        <noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ========================================== -->
  <!-- CAMERA SENSOR (ON THE GIMBAL/CAMERA LINK)  -->
  <!-- ========================================== -->
  <gazebo reference="camera_link">
    <!-- 5. RGB CAMERA (30 Hz) -->
    <sensor name="main_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <!-- Facing directly forward relative to the camera_link -->
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov> <!-- 90 Degree Field of View -->
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>1000.0</far></clip>
        <noise type="gaussian"><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

</robot>